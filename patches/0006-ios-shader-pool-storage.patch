@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: Copyright 2026 RMS contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <limits>
+
+namespace Common::IOS {
+
+// Retained UNUSED compiler slots, not a cap on an active translation or GPU cache.
+inline constexpr std::size_t INST_POOL_RETAIN_BYTES = 8 * 1024 * 1024;
+inline constexpr std::size_t BLOCK_POOL_RETAIN_BYTES = 1024 * 1024;
+inline constexpr std::size_t FLOW_POOL_RETAIN_BYTES = 1024 * 1024;
+
+struct ShaderPoolTrimStats {
+    std::size_t before_bytes;
+    std::size_t after_bytes;
+};
+
+constexpr std::size_t SaturatingStorageSum(std::size_t a, std::size_t b) noexcept {
+    return b > std::numeric_limits<std::size_t>::max() - a
+        ? std::numeric_limits<std::size_t>::max() : a + b;
+}
+
+constexpr std::size_t SaturatingStorageProduct(std::size_t a, std::size_t b) noexcept {
+    return b != 0 && a > std::numeric_limits<std::size_t>::max() / b
+        ? std::numeric_limits<std::size_t>::max() : a * b;
+}
+
+template <typename Chunks, typename Bytes>
+std::size_t PoolStorageBytes(const Chunks& chunks, Bytes&& bytes) noexcept {
+    std::size_t total = 0;
+    for (const auto& chunk : chunks) {
+        total = SaturatingStorageSum(total, bytes(chunk));
+    }
+    return total;
+}
+
+// PRECONDITION: the owner has already destroyed every live object. This performs
+// no allocation, shrink_to_fit, logging, VM operations or concurrent mutation.
+// Vector descriptor capacity is deliberately not included in the slot-byte bound.
+template <typename Chunks, typename Bytes>
+void TrimUnusedPoolChunks(Chunks& chunks, std::size_t retained_bytes, Bytes&& bytes) noexcept {
+    std::size_t keep = 0, total = 0;
+    for (const auto& chunk : chunks) {
+        const auto amount = bytes(chunk);
+        if (amount > retained_bytes - total) {
+            break;
+        }
+        total += amount;
+        ++keep;
+    }
+    // This only reduces size. Slot arrays are deleted; the vector's descriptors
+    // retain their small capacity, avoiding an allocation during exception cleanup.
+    chunks.resize(keep);
+}
+
+} // namespace Common::IOS

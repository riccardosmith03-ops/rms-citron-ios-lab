--- /dev/null
+++ b/CMakeModules/ios_prebuilt_dependencies.cmake
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Archives are built for iPhoneOS by the candidate CI dependency script.
+set(CITRON_IOS_DEPS_PREFIX "" CACHE PATH "Explicit iPhoneOS dependency prefix")
+if (NOT CITRON_IOS_DEPS_PREFIX)
+    message(FATAL_ERROR "Pass CITRON_IOS_DEPS_PREFIX; host macOS archives are unsupported")
+endif()
+set(_ios_ssl "${CITRON_IOS_DEPS_PREFIX}/openssl")
+set(_ios_ffmpeg "${CITRON_IOS_DEPS_PREFIX}/ffmpeg")
+foreach(_required
+        "${_ios_ssl}/include/openssl/ssl.h" "${_ios_ssl}/lib/libcrypto.a"
+        "${_ios_ssl}/lib/libssl.a" "${_ios_ffmpeg}/include/libavcodec/avcodec.h"
+        "${_ios_ffmpeg}/lib/libavfilter.a" "${_ios_ffmpeg}/lib/libswscale.a"
+        "${_ios_ffmpeg}/lib/libswresample.a" "${_ios_ffmpeg}/lib/libavcodec.a"
+        "${_ios_ffmpeg}/lib/libavutil.a")
+    if (NOT EXISTS "${_required}")
+        message(FATAL_ERROR "Missing iPhoneOS dependency: ${_required}")
+    endif()
+endforeach()
+add_library(OpenSSL::Crypto STATIC IMPORTED GLOBAL)
+set_target_properties(OpenSSL::Crypto PROPERTIES
+    IMPORTED_LOCATION "${_ios_ssl}/lib/libcrypto.a"
+    INTERFACE_INCLUDE_DIRECTORIES "${_ios_ssl}/include")
+add_library(OpenSSL::SSL STATIC IMPORTED GLOBAL)
+set_target_properties(OpenSSL::SSL PROPERTIES
+    IMPORTED_LOCATION "${_ios_ssl}/lib/libssl.a"
+    INTERFACE_INCLUDE_DIRECTORIES "${_ios_ssl}/include"
+    INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
+set(CITRON_FFMPEG_STATIC_DIR "${_ios_ffmpeg}" CACHE PATH "iPhoneOS FFmpeg" FORCE)
+set(FFmpeg_INCLUDE_DIR "${_ios_ffmpeg}/include")
+set(FFmpeg_LIBRARIES
+    "${_ios_ffmpeg}/lib/libavfilter.a" "${_ios_ffmpeg}/lib/libswscale.a"
+    "${_ios_ffmpeg}/lib/libswresample.a" "${_ios_ffmpeg}/lib/libavcodec.a"
+    "${_ios_ffmpeg}/lib/libavutil.a")
+set(FFmpeg_FOUND TRUE)
+set(FFmpeg_LDFLAGS "")

+// SPDX-FileCopyrightText: Copyright 2026 RMS contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace Common::IOS {
+
+enum class ZeroResetStatus : int {
+    Success = 0,
+    InvalidOwner = 1,
+    InvalidRange = 2,
+    InvalidPageSize = 3,
+    RemapFailed = 4,
+    UnexpectedAddress = 5,
+};
+
+struct ZeroResetResult {
+    ZeroResetStatus status;
+    int native_error;
+    bool Succeeded() const noexcept { return status == ZeroResetStatus::Success; }
+};
+
+// Contract: the caller owns this private-anonymous VA allocation, and the
+// requested bytes are exclusively available for initialization. No file,
+// fastmem/GPU host-pointer alias may depend on its old physical pages.
+// Only full host pages wholly inside the requested byte range are replaced.
+// On a remap error the range MUST NOT be used: MAP_FIXED failure may have
+// invalidated the old mapping. The owning iOS caller terminates, never falls back.
+inline ZeroResetResult ResetPrivateAnonymousToZero(void* owned_base, std::size_t owned_size,
+                                                  std::size_t offset,
+                                                  std::size_t length) noexcept {
+    const auto base = reinterpret_cast<std::uintptr_t>(owned_base);
+    if (owned_base == nullptr || owned_size == 0 ||
+        owned_size > std::numeric_limits<std::uintptr_t>::max() - base) {
+        return {ZeroResetStatus::InvalidOwner, EINVAL};
+    }
+    if (offset > owned_size || length > owned_size - offset) {
+        return {ZeroResetStatus::InvalidRange, ERANGE};
+    }
+    if (length == 0) {
+        return {ZeroResetStatus::Success, 0};
+    }
+    const int native_page_size = getpagesize();
+    if (native_page_size <= 0) {
+        return {ZeroResetStatus::InvalidPageSize, EINVAL};
+    }
+    const auto page_size = static_cast<std::size_t>(native_page_size);
+    if (base % page_size != 0) {
+        return {ZeroResetStatus::InvalidOwner, EINVAL};
+    }
+
+    const auto start = base + offset;
+    const auto prefix = std::min(length, (page_size - start % page_size) % page_size);
+    const auto remaining = length - prefix;
+    const auto middle = remaining - remaining % page_size;
+    const auto suffix = remaining - middle;
+    if (prefix != 0) {
+        std::memset(reinterpret_cast<void*>(start), 0, prefix);
+    }
+    if (middle != 0) {
+        void* const expected = reinterpret_cast<void*>(start + prefix);
+        void* const replacement = mmap(expected, middle, PROT_READ | PROT_WRITE,
+                                       MAP_FIXED | MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (replacement == MAP_FAILED) {
+            const int error = errno;
+            return {ZeroResetStatus::RemapFailed, error};
+        }
+        if (replacement != expected) {
+            return {ZeroResetStatus::UnexpectedAddress, EFAULT};
+        }
+    }
+    if (suffix != 0) {
+        std::memset(reinterpret_cast<void*>(start + prefix + middle), 0, suffix);
+    }
+    return {ZeroResetStatus::Success, 0};
+}
+
+} // namespace Common::IOS

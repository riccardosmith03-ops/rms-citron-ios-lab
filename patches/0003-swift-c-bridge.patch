+// SPDX-FileCopyrightText: Copyright 2026 Citron Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// C-only declarations matching src/ios/native.h. Import into Swift with
+// SWIFT_OBJC_BRIDGING_HEADER instead of assuming the Swift calling convention.
+
+#ifndef CITRON_IOS_SWIFT_BRIDGE_H
+#define CITRON_IOS_SWIFT_BRIDGE_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void (*CitronLifecycleCallback)(int result);
+
+void citron_ios_initialize(const char* _Nullable app_directory);
+void citron_ios_set_callbacks(CitronLifecycleCallback _Nullable started,
+                              CitronLifecycleCallback _Nullable stopped);
+void citron_ios_set_metal_layer(void* _Nullable metal_layer, int width, int height, float scale);
+int citron_ios_launch_game(const char* _Nullable filepath, int program_index);
+void citron_ios_pause(void);
+void citron_ios_resume(void);
+void citron_ios_stop(void);
+void citron_ios_shutdown(void);
+bool citron_ios_is_running(void);
+bool citron_ios_is_paused(void);
+void citron_ios_touch_began(int id, float x, float y);
+void citron_ios_touch_moved(int id, float x, float y);
+void citron_ios_touch_ended(int id);
+void citron_ios_set_button(int player_index, int button_id, bool pressed);
+void citron_ios_set_stick(int player_index, int stick_id, float x, float y);
+bool citron_ios_jit_available(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

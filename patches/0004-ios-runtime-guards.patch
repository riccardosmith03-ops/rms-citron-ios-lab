+// SPDX-FileCopyrightText: Copyright 2026 RMS contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace Loader::Detail {
+
+// Size-only counterpart of the no-NCE NSO image resize sequence. Each segment
+// replaces the preceding size, including shrink; it is deliberately not max().
+// Segment payload reads/decompression stay in LoadModule. This helper owns no bytes.
+// Inputs whose materialization would overflow/truncate the 32-bit NSO image or
+// overrun its fixed argument reservation are refused, not treated as parity cases.
+class NsoLayoutSize final {
+public:
+    bool ReplaceSegment(std::uint32_t location, std::size_t decoded_size) noexcept {
+        if (decoded_size > MaxImageSize || location > MaxImageSize - decoded_size) {
+            return false;
+        }
+        size = static_cast<std::size_t>(location) +
+               static_cast<std::uint32_t>(decoded_size);
+        return true;
+    }
+
+    bool AppendArguments(std::size_t argument_size, std::uint32_t reservation,
+                         std::size_t header_size) noexcept {
+        if (header_size > reservation || argument_size > reservation - header_size ||
+            size > MaxImageSize - reservation) {
+            return false;
+        }
+        size = static_cast<std::uint32_t>(size) + reservation;
+        return true;
+    }
+
+    std::optional<std::uint32_t> Finish(std::uint32_t bss_size,
+                                      std::uint64_t page_mask) const noexcept {
+        if (size > MaxImageSize - bss_size || page_mask == 0 ||
+            page_mask == std::numeric_limits<std::uint64_t>::max() ||
+            (page_mask & (page_mask + 1)) != 0) {
+            return std::nullopt;
+        }
+        // Original addition is u32 before PageAlignSizeNSO widens for its u64 mask.
+        // Only its non-wrapping, representable domain is eligible for elision.
+        const auto unaligned = static_cast<std::uint32_t>(size) + bss_size;
+        const auto aligned = (static_cast<std::uint64_t>(unaligned) + page_mask) & ~page_mask;
+        if (aligned > MaxImageSize) {
+            return std::nullopt;
+        }
+        return static_cast<std::uint32_t>(aligned);
+    }
+
+    std::size_t Size() const noexcept { return size; }
+
+private:
+    static constexpr std::size_t MaxImageSize =
+        std::numeric_limits<std::uint32_t>::max();
+    std::size_t size{};
+};
+
+} // namespace Loader::Detail

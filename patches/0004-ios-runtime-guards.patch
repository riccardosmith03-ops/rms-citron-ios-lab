+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace Common::IOS {
+
+// Pure checked eligibility for the existing NSO dense prefix + BSS + page padding.
+// No byte-content inference: all arguments/reserved argument bytes remain materialized.
+inline std::optional<std::uint32_t> NsoZeroTailFullSize(std::size_t prefix_bytes,
+                                                      std::uint32_t bss_bytes,
+                                                      std::uint32_t legacy_full_size,
+                                                      bool segments_exact_ordered,
+                                                      bool load_into_process,
+                                                      bool patch_or_dump) noexcept {
+    constexpr std::uint64_t max = std::numeric_limits<std::uint32_t>::max();
+    constexpr std::uint64_t mask = 4095;
+    if (!segments_exact_ordered || !load_into_process || patch_or_dump || prefix_bytes > max ||
+        bss_bytes > max - prefix_bytes || prefix_bytes + bss_bytes > max - mask) {
+        return std::nullopt;
+    }
+    const auto full = (static_cast<std::uint64_t>(prefix_bytes) + bss_bytes + mask) & ~mask;
+    if (full != legacy_full_size || full <= prefix_bytes) {
+        return std::nullopt;
+    }
+    return static_cast<std::uint32_t>(full);
+}
+
+// Value-only bookkeeping: Arm may be called ONLY after a new code allocation has
+// actually been cleared to zero. It records no pointer and performs no VM action.
+// Every dense OR sparse module consumes its full span. Overlap, a failed copy or
+// a non-Created process permanently invalidates this initial-allocation proof.
+class InitialCodeZeroState {
+public:
+    void Arm(std::uint64_t base, std::uint64_t size) noexcept {
+        valid = size != 0 && size <= std::numeric_limits<std::uint64_t>::max() - base;
+        begin = next = base;

+// SPDX-FileCopyrightText: Copyright 2026 RMS Citron iOS contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace IOS {
+
+// A single deferred ExecuteProgram request, not a task queue. Guest callbacks
+// publish without acquiring the session mutex. Only the owned session worker
+// consumes, AFTER joining old guest/CPU/detached work. Frontend Stop cancels the
+// entire epoch. BeginSession is valid only after the preceding worker joined.
+static_assert(std::atomic<std::uint64_t>::is_always_lock_free,
+              "Deferred program switch requires lock-free 64-bit atomics");
+
+class DeferredProgramSwitch final {
+public:
+    static constexpr std::uint64_t MaxProgramIndex =
+        static_cast<std::uint64_t>(std::numeric_limits<std::int32_t>::max());
+
+    void BeginSession() noexcept { state.store(Idle, std::memory_order_release); }
+
+    bool Request(std::size_t index) noexcept {
+        if (index > MaxProgramIndex) {
+            return false;
+        }
+        auto expected = Idle;
+        return state.compare_exchange_strong(expected, static_cast<std::uint64_t>(index),
+                                              std::memory_order_acq_rel,
+                                              std::memory_order_acquire);
+    }
+
+    void Cancel() noexcept { state.store(Cancelled, std::memory_order_release); }
+
+    bool IsCancelled() const noexcept {
+        return state.load(std::memory_order_acquire) == Cancelled;
+    }
+
+    std::optional<std::size_t> TakePending() noexcept {
+        auto expected = state.load(std::memory_order_acquire);
+        if (expected > MaxProgramIndex ||
+            !state.compare_exchange_strong(expected, Idle, std::memory_order_acq_rel,
+                                            std::memory_order_acquire)) {
+            return std::nullopt;
+        }
+        return static_cast<std::size_t>(expected);
+    }
+
+private:
+    static constexpr auto Cancelled = std::numeric_limits<std::uint64_t>::max();
+    static constexpr auto Idle = Cancelled - 1;
+    std::atomic<std::uint64_t> state{Cancelled};
+};
+
+} // namespace IOS

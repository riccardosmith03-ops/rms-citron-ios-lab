+namespace Common::IOS::RenderProbe {
+using Generation = std::uint64_t;
+using Clock = std::chrono::steady_clock;
+enum class Stage : std::size_t {
+    LaunchSetup, SystemLoad, RunEmulation, SystemRun, GpfifoSubmit, GpuListProcess,
+    QueueBuffer, AcquireFramebuffer, RequestComposite, FencesReady, Composite,
+    GetRenderFrame, Present, FirstFrame, Count
+};
+enum class Counter : std::size_t {
+    QueueSuccess, AcquireSuccess, CompositeFenceTotal, PartialMapChunks, PartialMapPages,
+    UnmappedReadChunks, UnmappedReadBytes, UnmappedWriteChunks, UnmappedWriteBytes,
+    CompositeEmpty, CompositeSkipped, CompositeHidden, Count
+};
+inline constexpr std::size_t MemoryGaugeCount = 6;
+struct MemoryValues {
+    std::uint64_t texture_owned_bytes{}, buffer_owned_bytes{}, shared_target_bytes{};
+    std::uint64_t vma_allocation_bytes{}, vma_block_bytes{};
+    bool valid = false;
+};
+inline constexpr std::size_t StageCount = static_cast<std::size_t>(Stage::Count);
+inline constexpr std::size_t CounterCount = static_cast<std::size_t>(Counter::Count);
+inline constexpr std::uint64_t WindowUs = 30'000'000;
+inline constexpr std::uint64_t IntervalUs = 1'000'000;
+inline constexpr unsigned MaxRecords = 32;
+inline constexpr std::size_t MaxBytes = 128 * 1024;
+inline constexpr const char* FileName = "render-stage-probe.jsonl";
+
+namespace Detail {
+struct Stats {
+    std::atomic<std::uint64_t> enter{}, exit{}, first_enter_us{}, last_enter_us{}, first_exit_us{}, last_exit_us{};
+};
+struct State {
+    std::atomic<bool> enabled{false};
+    std::atomic<Generation> generation{};
+    // Never reset: a delayed failed acquisition may still release its control lease.
+    std::atomic<std::uint64_t> active_scopes{};
+    std::array<Stats, StageCount> stages{};
+    std::array<std::atomic<std::uint64_t>, CounterCount> counters{};
+    std::array<std::atomic<std::uint64_t>, MemoryGaugeCount> memory{};
+    // Only accepted metric leases can touch these fields; Begin refuses their reuse.
+    std::atomic<bool> sampling_memory{false};
+    std::atomic<std::uint64_t> memory_sequence{};
+    std::uint64_t last_memory_attempt_us{};
+    std::uint64_t pid{};
+    Clock::time_point origin{};
+    std::uint64_t window_us = WindowUs;
+};
+inline State state;
+inline thread_local Generation callback_generation = 0;
+inline thread_local bool callback_bound = false;
+inline void Maximum(std::atomic<std::uint64_t>& value, std::uint64_t next) noexcept {
+    auto old = value.load(std::memory_order_relaxed);
+    while (old < next && !value.compare_exchange_weak(old, next, std::memory_order_relaxed)) {}
+}
+inline void First(std::atomic<std::uint64_t>& value, std::uint64_t next) noexcept {
+    auto old = value.load(std::memory_order_relaxed);
+    while ((old == 0 || next < old) &&
+           !value.compare_exchange_weak(old, next, std::memory_order_relaxed)) {}
+}
+inline std::uint64_t ElapsedUs() noexcept {
+    const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+        Clock::now() - state.origin).count();
+    return elapsed > 0 ? static_cast<std::uint64_t>(elapsed) : 1;
+}
+inline bool InWindow(std::uint64_t elapsed) noexcept {
+    if (elapsed > state.window_us) {
+        // A delayed recorder must not keep clock-reading hooks enabled forever.
+        state.enabled.store(false, std::memory_order_seq_cst);
+        return false;
+    }
+    return state.enabled.load(std::memory_order_seq_cst);
+}
+inline bool Acquire(Generation generation) noexcept {
+    if (generation == 0 || !state.enabled.load(std::memory_order_seq_cst) ||
+        state.generation.load(std::memory_order_seq_cst) != generation) return false;
+    state.active_scopes.fetch_add(1, std::memory_order_seq_cst);
+    // No origin/counter access before this recheck. End disables publication;
+    // Begin refuses reset with an accepted scope still holding a lease.
+    if (!state.enabled.load(std::memory_order_seq_cst) ||
+        state.generation.load(std::memory_order_seq_cst) != generation) {
+        state.active_scopes.fetch_sub(1, std::memory_order_seq_cst);
+        return false;
+    }
+    return true;
+}
+inline void Release() noexcept { state.active_scopes.fetch_sub(1, std::memory_order_seq_cst); }
+} // namespace Detail
+
+inline Generation CaptureGeneration() noexcept {
+    if (Detail::callback_bound) return Detail::callback_generation;
+    if (!Detail::state.enabled.load(std::memory_order_seq_cst)) return 0;
+    return Detail::state.generation.load(std::memory_order_seq_cst);
+}
+// Async work retains its creator's integer generation, including nested hooks.
+// It never owns State memory or holds a lease while waiting to be dispatched.
+class CallbackGeneration final {
+public:
+    explicit CallbackGeneration(Generation value) noexcept
+        : previous{Detail::callback_generation}, was_bound{Detail::callback_bound} {
+        Detail::callback_generation = value;
+        Detail::callback_bound = true;
+    }
+    ~CallbackGeneration() {
+        Detail::callback_generation = previous;
+        Detail::callback_bound = was_bound;
+    }
+    CallbackGeneration(const CallbackGeneration&) = delete;
+    CallbackGeneration& operator=(const CallbackGeneration&) = delete;
+private:
+    Generation previous;
+    bool was_bound;
+};
+class Scope final {
+public:
+    explicit Scope(Stage stage) noexcept : Scope(stage, CaptureGeneration()) {}
+    Scope(Stage stage, Generation generation) noexcept : stage{stage}, generation{generation} {
+        if (static_cast<std::size_t>(stage) >= StageCount || !Detail::Acquire(generation)) return;
+        leased = true;
+        const auto time = Detail::ElapsedUs();
+        if (!Detail::InWindow(time)) { Close(); return; }
+        auto& stats = Detail::state.stages[static_cast<std::size_t>(stage)];
+        stats.enter.fetch_add(1, std::memory_order_relaxed);
+        Detail::First(stats.first_enter_us, time);
+        Detail::Maximum(stats.last_enter_us, time);
+        entered = true;
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope() { Close(); }
+    void Close() noexcept {
+        if (!leased) return;
+        if (entered && Detail::state.enabled.load(std::memory_order_seq_cst) &&
+            Detail::state.generation.load(std::memory_order_seq_cst) == generation) {
+            const auto time = Detail::ElapsedUs();
+            if (Detail::InWindow(time)) {
+                auto& stats = Detail::state.stages[static_cast<std::size_t>(stage)];
+                stats.exit.fetch_add(1, std::memory_order_relaxed);
+                Detail::First(stats.first_exit_us, time);
+                Detail::Maximum(stats.last_exit_us, time);
+            }
+        }
+        entered = false;
+        leased = false;
+        Detail::Release();
+    }
+private:
+    Stage stage;
+    Generation generation;
+    bool leased = false;
+    bool entered = false;
+};
+inline void Event(Stage stage, Generation generation) noexcept { Scope scope{stage, generation}; }
+inline void Event(Stage stage) noexcept { Event(stage, CaptureGeneration()); }
+inline void Add(Counter counter, std::uint64_t amount, Generation generation) noexcept {
+    if (static_cast<std::size_t>(counter) >= CounterCount || !Detail::Acquire(generation)) return;
+    if (Detail::InWindow(Detail::ElapsedUs()))
+        Detail::state.counters[static_cast<std::size_t>(counter)].fetch_add(amount,
+                                                                         std::memory_order_relaxed);
+    Detail::Release();
+}
+inline void Add(Counter counter, std::uint64_t amount = 1) noexcept {
+    Add(counter, amount, CaptureGeneration());
+}
+
+
+namespace Detail {
+struct Lease final {
+    explicit Lease(Generation value) noexcept : accepted{Acquire(value)} {}
+    ~Lease() { if (accepted) Release(); }
+    bool accepted;
+};
+inline bool CopyMemory(std::array<std::uint64_t, MemoryGaugeCount>& values) noexcept {
+    const auto first = state.memory_sequence.load(std::memory_order_seq_cst);
+    if (first == 0 || (first & 1U) != 0) return false;
+    for (std::size_t i = 0; i < MemoryGaugeCount; ++i)
+        values[i] = state.memory[i].load(std::memory_order_seq_cst);
+    return state.memory_sequence.load(std::memory_order_seq_cst) == first;
+}
+template <typename F>
+bool SampleMemoryImpl(F&& sample, Generation generation, std::uint64_t interval) noexcept {
+    Lease lease{generation};
+    if (!lease.accepted) return false;
+    if (state.sampling_memory.exchange(true, std::memory_order_seq_cst)) return false;
+    struct Clear final {
+        ~Clear() { state.sampling_memory.store(false, std::memory_order_seq_cst); }
+    } clear;
+    const auto begin = ElapsedUs();
+    if (!InWindow(begin) ||
+        (state.last_memory_attempt_us != 0 && begin - state.last_memory_attempt_us < interval))
+        return false;
+    state.last_memory_attempt_us = begin;
+    try {
+        const auto values = sample(); // GPU owner only, at most once per second in production.
+        if (!values.valid || !state.enabled.load(std::memory_order_seq_cst) ||
+            state.generation.load(std::memory_order_seq_cst) != generation) return false;
+        const auto time = ElapsedUs();
+        if (!InWindow(time)) return false;
+        const auto sequence = state.memory_sequence.load(std::memory_order_seq_cst);
+        if (sequence > UINT64_MAX - 2) return false;
+        state.memory_sequence.store(sequence + 1, std::memory_order_seq_cst);
+        const std::array<std::uint64_t, MemoryGaugeCount> next{
+            values.texture_owned_bytes, values.buffer_owned_bytes, values.shared_target_bytes,
+            values.vma_allocation_bytes, values.vma_block_bytes, time};
+        for (std::size_t i = 0; i < MemoryGaugeCount; ++i)
+            state.memory[i].store(next[i], std::memory_order_seq_cst);
+        state.memory_sequence.store(sequence + 2, std::memory_order_seq_cst);
+        return true;
+    } catch (...) {
+        return false; // Observability failure never changes emulation.
+    }
+}
+} // namespace Detail
+template <typename F>
+inline bool SampleMemory(F&& sample, Generation generation) noexcept {
+    return Detail::SampleMemoryImpl(sample, generation, IntervalUs);
+}
+template <typename F>
+inline bool SampleMemory(F&& sample) noexcept {
+    return SampleMemory(sample, CaptureGeneration());
+}
+#if defined(CITRON_RENDER_PROBE_HOST_TEST)
+template <typename F>
+inline bool SampleMemoryForHostTest(F&& sample, Generation generation) noexcept {
+    return Detail::SampleMemoryImpl(sample, generation, 0);
+}
+#endif
+
+class Recorder final {
+public:
+    ~Recorder() { End(); }
+    Recorder() = default;
+    Recorder(const Recorder&) = delete;
+    Recorder& operator=(const Recorder&) = delete;
+    bool Begin(const std::filesystem::path& own_documents_directory) noexcept {
+        return BeginImpl(own_documents_directory, WindowUs, IntervalUs);
+    }
+#if defined(CITRON_RENDER_PROBE_HOST_TEST)
+    bool BeginForHostTest(const std::filesystem::path& directory, std::uint64_t window,
+                         std::uint64_t interval) noexcept {
+        return BeginImpl(directory, window, interval);
+    }
+    unsigned RecordsForHostTest() const noexcept { return records; }
+#endif
+    // Native lifecycle owns serialization. Call only after all instrumented workers
+    // and detached tasks have drained, outside session/GPU/logger/main-queue locks.
+    void End() noexcept {
+        Detail::state.enabled.store(false, std::memory_order_seq_cst);
+        {
+            // Pair predicate mutation with wait_mutex: no check-to-sleep lost wake.
+            std::lock_guard lock{wait_mutex};
+            stop_requested.store(true, std::memory_order_seq_cst);
+        }
+        wake.notify_one();
+        if (worker.joinable()) worker.join();
+        // State is not reset here. Begin additionally refuses any surviving Scope.
+    }
+private:
+    bool BeginImpl(const std::filesystem::path& directory, std::uint64_t window,
+                   std::uint64_t interval) noexcept {
+        auto& state = Detail::state;
+        if (worker.joinable() || state.enabled.load(std::memory_order_seq_cst) ||
+            state.active_scopes.load(std::memory_order_seq_cst) != 0 ||
+            window == 0 || window > WindowUs || interval == 0 || interval > window ||
+            window / interval > 30) return false;
+        const auto old = state.generation.load(std::memory_order_seq_cst);
+        if (old == UINT64_MAX) return false;
+        for (auto& s : state.stages) {
+            s.enter.store(0, std::memory_order_relaxed);
+            s.exit.store(0, std::memory_order_relaxed);
+            s.first_enter_us.store(0, std::memory_order_relaxed);
+            s.last_enter_us.store(0, std::memory_order_relaxed);
+            s.first_exit_us.store(0, std::memory_order_relaxed);
+            s.last_exit_us.store(0, std::memory_order_relaxed);
+        }
+        for (auto& count : state.counters) count.store(0, std::memory_order_relaxed);
+        for (auto& value : state.memory) value.store(0, std::memory_order_seq_cst);
+        state.memory_sequence.store(0, std::memory_order_seq_cst);
+        state.last_memory_attempt_us = 0;
+        state.pid = static_cast<std::uint64_t>(::getpid());
+        state.origin = Clock::now();
+        state.window_us = window;
+        state.generation.store(old + 1, std::memory_order_seq_cst);
+        records = 0;
+        bytes = 0;
+        stop_requested.store(false, std::memory_order_seq_cst);
+        state.enabled.store(true, std::memory_order_seq_cst);
+        try {
+            worker = std::thread([this, directory, window, interval] { Run(directory, window, interval); });
+            return true;
+        } catch (...) {
+            state.enabled.store(false, std::memory_order_seq_cst);
+            return false; // Diagnostics must not alter launch success/failure.
+        }
+    }
+    static FILE* Open(const std::filesystem::path& documents) noexcept {
+        // The only production anchor comes from FileManager's own Documents URL.
+        // Never follow app-writable citron/log components or a substituted basename.
+        int dir = open(documents.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        if (dir < 0) return nullptr;
+        struct stat info{};
+        if (fstat(dir, &info) != 0 || !S_ISDIR(info.st_mode) || info.st_uid != geteuid()) {
+            close(dir); return nullptr;
+        }
+        for (const char* component : {"citron", "log"}) {
+            const int child = openat(dir, component, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+            close(dir);
+            if (child < 0) return nullptr;
+            dir = child;
+            if (fstat(dir, &info) != 0 || !S_ISDIR(info.st_mode) || info.st_uid != geteuid()) {
+                close(dir); return nullptr;
+            }
+        }
+        // O_NONBLOCK avoids blocking on a substituted FIFO before fstat rejects it.
+        const int fd = openat(dir, FileName, O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0600);
+        close(dir);
+        if (fd < 0) return nullptr;
+        if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) || info.st_nlink != 1 ||
+            info.st_uid != geteuid() || fchmod(fd, 0600) != 0 || ftruncate(fd, 0) != 0) {
+            close(fd); return nullptr;
+        }
+        FILE* file = fdopen(fd, "w");
+        if (!file) close(fd);
+        return file;
+    }
+    bool Snapshot(FILE* file, unsigned reason) noexcept {
+        if (records >= MaxRecords) return false;
+        std::array<std::uint64_t, MemoryGaugeCount> memory{};
+        // Capture gauges before record time; a coherent sample cannot be from its future.
+        const bool has_memory = Detail::CopyMemory(memory);
+        char line[4096];
+        std::size_t used = 0;
+        bool valid = true;
+        const auto append = [&](const char* format, auto... values) {
+            if (!valid) return;
+            int count = 0;
+            if constexpr (sizeof...(values) == 0) {
+                count = std::snprintf(line + used, sizeof(line) - used, "%s", format);
+            } else {
+                count = std::snprintf(line + used, sizeof(line) - used, format, values...);
+            }
+            if (count < 0 || static_cast<std::size_t>(count) >= sizeof(line) - used) valid = false;
+            else used += static_cast<std::size_t>(count);
+        };
+        const auto load = [](const auto& value) {
+            return static_cast<unsigned long long>(value.load(std::memory_order_relaxed));
+        };
+        append("{\"v\":2,\"pid\":%llu,\"g\":%llu,\"t_us\":%llu,\"r\":%u,\"enabled\":%u,\"s\":[",
+               static_cast<unsigned long long>(Detail::state.pid),
+               load(Detail::state.generation),
+               static_cast<unsigned long long>(Detail::ElapsedUs()), reason,
+               Detail::state.enabled.load(std::memory_order_seq_cst) ? 1U : 0U);
+        for (std::size_t i = 0; i < StageCount; ++i) {
+            const auto& s = Detail::state.stages[i];
+            append("%s[%llu,%llu,%llu,%llu,%llu,%llu]", i ? "," : "", load(s.enter), load(s.exit),
+                   load(s.first_enter_us), load(s.last_enter_us), load(s.first_exit_us), load(s.last_exit_us));
+        }
+        append("],\"c\":[");
+        for (std::size_t i = 0; i < CounterCount; ++i)
+            append("%s%llu", i ? "," : "", load(Detail::state.counters[i]));
+        append("]");
+        if (has_memory) {
+            append(",\"m\":[");
+            for (std::size_t i = 0; i < MemoryGaugeCount; ++i)
+                append("%s%llu", i ? "," : "", static_cast<unsigned long long>(memory[i]));
+            append("]");
+        }
+        append("}\n");
+        if (!valid || used > MaxBytes - bytes || std::fwrite(line, 1, used, file) != used ||
+            std::fflush(file) != 0) return false;
+        ++records;
+        bytes += used;
+        return true;
+    }
+    void Run(const std::filesystem::path& directory, std::uint64_t window,
+             std::uint64_t interval) noexcept {
+        FILE* file = Open(directory);
+        if (!file) { Detail::state.enabled.store(false, std::memory_order_seq_cst); return; }
+        bool good = Snapshot(file, 0);
+        const auto deadline = Detail::state.origin + std::chrono::microseconds(window);
+        auto next = Detail::state.origin + std::chrono::microseconds(interval);
+        while (good && next < deadline) {
+            std::unique_lock lock{wait_mutex};
+            if (wake.wait_until(lock, next, [this] { return stop_requested.load(std::memory_order_seq_cst); })) break;
+            lock.unlock();
+            if (Clock::now() >= deadline) break;
+            good = Snapshot(file, 1);
+            // Skip missed periods instead of emitting a catch-up burst.
+            next = Clock::now() + std::chrono::microseconds(interval);
+        }
+        if (good && !stop_requested.load(std::memory_order_seq_cst)) {
+            std::unique_lock lock{wait_mutex};
+            wake.wait_until(lock, deadline, [this] { return stop_requested.load(std::memory_order_seq_cst); });
+        }
+        Detail::state.enabled.store(false, std::memory_order_seq_cst);
+        if (good) (void)Snapshot(file, stop_requested.load(std::memory_order_seq_cst) ? 3 : 2);
+        std::fclose(file);
+    }
+    std::thread worker;
+    std::atomic<bool> stop_requested{false};
+    std::mutex wait_mutex;
+    std::condition_variable wake;
+    unsigned records = 0;
+    std::size_t bytes = 0;
+};
+// One instance for the one EmulationSession. Lifecycle entrypoints serialize it.
+inline Recorder recorder;
+} // namespace Common::IOS::RenderProbe

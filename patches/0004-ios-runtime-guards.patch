+bool MemoryAllocator::GetProbeMemoryStatistics(u64& allocation_bytes, u64& block_bytes) const noexcept {
+    allocation_bytes = 0;
+    block_bytes = 0;
+    if (properties.memoryHeapCount == 0 || properties.memoryHeapCount > VK_MAX_MEMORY_HEAPS)
+        return false;
+    std::array<VmaBudget, VK_MAX_MEMORY_HEAPS> budgets{};
+    // VMA3.1 fills exactly its physical memoryHeapCount entries.
+    // No allocation callbacks or explicit GPU waits; VMA may take internal locks.
+    vmaGetHeapBudgets(allocator, budgets.data());
+    for (u32 i = 0; i < properties.memoryHeapCount; ++i) {
+        const auto& statistics = budgets[i].statistics;
+        if (statistics.allocationBytes > statistics.blockBytes ||
+            statistics.allocationBytes > std::numeric_limits<u64>::max() - allocation_bytes ||
+            statistics.blockBytes > std::numeric_limits<u64>::max() - block_bytes)
+            return false;
+        allocation_bytes += statistics.allocationBytes;
+        block_bytes += statistics.blockBytes;
+    }
+    return true;
+}
